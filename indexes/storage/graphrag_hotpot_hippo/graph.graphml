      <data key="d0">left behind  the kids</data>
      <data key="d1">event</data>
      <data key="d2">Left Behind: The Kids is a series of 40 short novels aimed at young adults, depicting the experiences of teenagers during the rapture and tribulation, based on biblical scriptures.</data>
      <data key="d3">807724ce4314af6e3115bb688e731087dd9023732c48c2045b7e35532540c23c_chunk_0</data>
