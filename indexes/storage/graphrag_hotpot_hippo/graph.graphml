    <node id="steampunk">
      <data key="d0">steampunk</data>
      <data key="d1">event</data>
      <data key="d2">Steampunk is a subgenre of science fiction that incorporates technology and aesthetic designs inspired by 19th-century industrial steam-powered machinery, which is a defining characteristic of Etiquette &amp; Espionage.</data>
      <data key="d3">2a153f594ef1b5a08e9aba77c362b439d14a5b832a1753d7b304f4c883623f0f_chunk_0</data>
