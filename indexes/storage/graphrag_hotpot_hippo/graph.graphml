    </node>
    <node id="tobias">
      <data key="d0">tobias</data>
      <data key="d1">person</data>
      <data key="d2">Tobias is a character who introduces the story in 'The Hork-Bajir Chronicles' and plays a role in the narrative by flying to the valley of the free Hork-Bajir.</data>
      <data key="d3">28e024bab6cacddbb6d7ef113c676dfdcc16af8996f82f7e937692f5e9d39517_chunk_0</data>
